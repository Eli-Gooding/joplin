# LangSmith Configuration
# These settings are required for tracing with LangSmith
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com  # LangSmith API endpoint
LANGCHAIN_API_KEY=                               # Your LangSmith API key (required)
LANGCHAIN_PROJECT=joplin-chat                    # Project name in LangSmith

# LLM Configuration
# These settings control the behavior of the language model
LANGCHAIN_MODEL=gpt-3.5-turbo              # The model to use for chat (e.g., gpt-3.5-turbo, gpt-4)
LANGCHAIN_TEMPERATURE=0.7                   # Controls response randomness (0.0-1.0)
LANGCHAIN_MAX_TOKENS=1000                   # Maximum tokens per response

# Note: For local development, you can use the default values above.
# For production, you should:
# 1. Use a secure API key
# 2. Configure a proper LangSmith endpoint
# 3. Adjust the model and parameters based on your needs
